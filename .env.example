# Copiá este archivo como .env.local para probar el asistente en tu compu.
# En Vercel se cargan en Settings > Environment Variables.

# Obligatoria para el asistente. Se usa solo en el servidor (/api/chat).
ANTHROPIC_API_KEY=

# Opcional. Modelo del asistente (por defecto claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcional. Mensajes por día (por defecto 30).
CHAT_DAILY_LIMIT=30

# Recomendada. Si la cargás, el asistente pide este código una vez en cada dispositivo.
RUMBO_ACCESS_CODE=
